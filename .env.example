# Copie ce fichier en .env puis adapte les valeurs.
# .env ne doit JAMAIS être commit (voir .gitignore).

# --- Base de données ---
POSTGRES_USER=contenulocal
POSTGRES_PASSWORD=change_moi_en_local
POSTGRES_DB=contenulocal

# --- Clés externes (laisser vide tant que pas utilisé) ---
OPENAI_API_KEY=
# Clé pour chiffrer les tokens OAuth en base (génère : openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=
